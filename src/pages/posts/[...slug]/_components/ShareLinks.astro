---
import LinkButton from "@/components/LinkButton.astro";
import qrcode from "qrcode-generator";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url.toString();

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

/**
 * 构建期生成「当前页 URL」的二维码 SVG。
 * 微信没有对外的网页分享接口（JS-SDK 只能跑在微信内置浏览器里），
 * 通行做法是弹二维码让访客扫码打开、再从微信内部转发。
 * 内联进 HTML 的体积 gzip 后约 1.7KB，可接受。
 */
const buildQrSvg = (text: string) => {
  const qr = qrcode(0, "M");
  qr.addData(text);
  qr.make();
  return qr.createSvgTag({ cellSize: 2, margin: 4, scalable: true });
};

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle, type = "link" }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));

    return {
      type,
      title,
      Icon,
      // link 拼接平台前缀；copy 原样作为落地页；qrcode 不跳转
      href: type === "link" ? `${url ?? ""}${pageUrl}` : url,
      qrSvg: type === "qrcode" ? buildQrSvg(pageUrl) : "",
    };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="flex flex-wrap items-center">
        {items.map(({ type, title, Icon, href, qrSvg }) =>
          !Icon ? null : type === "qrcode" ? (
            <details class="relative">
              <summary
                class="flex cursor-pointer list-none scale-90 p-2 hover:rotate-6 hover:text-accent sm:p-1"
                title={title}
              >
                <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 sm:scale-110" />
                <span class="sr-only">{title}</span>
              </summary>
              {/* 二维码必须是深色模块 + 浅色底才扫得动，因此这里固定白底，不跟随暗色主题 */}
              <div class="border-border absolute bottom-full left-1/2 z-50 mb-2 -translate-x-1/2 rounded-xl border bg-white p-4 shadow-lg">
                <div
                  class="w-40 [&>svg]:h-auto [&>svg]:w-full"
                  set:html={qrSvg}
                />
                <p
                  class="mt-2 text-center text-xs whitespace-nowrap text-neutral-600"
                >
                  用微信扫一扫打开
                </p>
              </div>
            </details>
          ) : (
            <LinkButton
              href={href}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              title={title}
              target="_blank"
              rel="noopener noreferrer"
              data-share-copy={type === "copy" ? "" : undefined}
              data-share-url={type === "copy" ? pageUrl : undefined}
            >
              <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{title}</span>
            </LinkButton>
          )
        )}
      </div>
    </div>
  )
}

<script>
  // B 站这类没有网页分享接口的平台：点击时先把文章链接写进剪贴板，再打开落地页。
  // 剪贴板不可用（非 HTTPS 或权限被拒）时静默降级，落地页照常打开。
  document.addEventListener("click", async event => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const url = target
      .closest("[data-share-copy]")
      ?.getAttribute("data-share-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // 忽略：非 HTTPS 或用户拒绝授权
    }
  });
</script>
